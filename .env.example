# Database (MySQL/MariaDB compatible)
DATABASE_URL="mysql://username:password@host:3306/mr_mailer"

# Redis
REDIS_URL="redis://localhost:6379"

# Public origin of this deployment. No trailing slash.
# The OAuth callbacks are derived from it as:
#   <APP_BASE_URL>/auth/google/callback
#   <APP_BASE_URL>/auth/microsoft/callback
# and both must be registered with their providers exactly as derived.
# Required in production; defaults to http://localhost:3000 in development.
# Must be https://, except http:// is allowed only for localhost.
# NOTE: the former GOOGLE_REDIRECT_URI and MICROSOFT_REDIRECT_URI variables are
# no longer read. Setting them has no effect.
APP_BASE_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Microsoft OAuth (Outlook / Microsoft 365)
# Set MICROSOFT_TENANT_ID to "consumers" for personal accounts only,
# "common" for both personal and work/school, or an Entra tenant id.
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_TENANT_ID="consumers"

# Groq (AI summaries)
GROQ_API_KEY="your-groq-api-key"
# Optional. Groq retires models without notice — list what your key can reach at
# https://api.groq.com/openai/v1/models. Defaults to openai/gpt-oss-120b.
GROQ_MODEL="openai/gpt-oss-120b"

# Session/encryption (generate a random 32+ char hex string for production)
SESSION_SECRET="generate-a-random-32-char-string-here"

# Data retention (days)
RETENTION_DAYS=90