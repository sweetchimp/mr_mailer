# Database (MySQL/MariaDB compatible — works with Railway, PlanetScale, etc.)
DATABASE_URL="mysql://username:password@host:3306/mr_mailer?allowPublicKeyRetrieval=true"

# Redis (works with Railway, Upstash, etc.)
REDIS_URL="redis://localhost:6379"

# Google OAuth
# In production, set this to your Railway app URL + /auth/google/callback
# e.g. https://your-app.up.railway.app/auth/google/callback
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# Microsoft OAuth (Outlook / Microsoft 365)
# In production, set this to your Railway app URL + /auth/microsoft/callback
# Set MICROSOFT_TENANT_ID to your Entra tenant id, or "common" to support both
# personal Microsoft accounts and work/school accounts.
MICROSOFT_CLIENT_ID="your-microsoft-client-id"
MICROSOFT_CLIENT_SECRET="your-microsoft-client-secret"
MICROSOFT_TENANT_ID="common"
MICROSOFT_REDIRECT_URI="http://localhost:3000/auth/microsoft/callback"

# Groq (AI summaries)
GROQ_API_KEY="your-groq-api-key"

# Session/encryption (generate a random 32+ char hex string for production)
SESSION_SECRET="generate-a-random-32-char-string-here"

# Data retention (days)
RETENTION_DAYS=90

# Port (Railway assigns this dynamically — do not set in .env for production)
# PORT=3000
