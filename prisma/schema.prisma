generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(uuid()) @map("id")
  email                String           @unique @map("email")
  name                 String?          @map("name")
  googleId             String?          @unique @map("google_id")
  microsoftId          String?          @unique @map("microsoft_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  preferredMorningTime String           @default("07:00") @map("preferred_morning_time")
  tokenRevokedAt       DateTime?        @map("token_revoked_at")
  /// Opt-in for the Sunday evening summary email. Off by default because it is
  /// the one thing this app sends that the user did not ask to be sent, using a
  /// mail scope they consented to for replies.
  weeklyDigestEmail    Boolean          @default(false) @map("weekly_digest_email")
  emailSummaries       EmailSummary[]
  senderPreferences    SenderPreference[]
  jobFailures          JobFailure[]
  oauthTokens          OAuthToken[]
  replyFeedback        ReplyFeedback[]
  replyStyleProfile    ReplyStyleProfile?
  meetingReminders     MeetingReminder[]
  meetingMinutes       MeetingMinutes[]
  scheduleBlocks       ScheduleBlock[]
  subscription         Subscription?

  @@map("users")
}

model OAuthToken {
  id           String   @id @default(uuid()) @map("id")
  userId       String   @map("user_id")
  accessToken  String   @map("access_token") @db.Text
  refreshToken String   @map("refresh_token") @db.Text
  expiresAt    DateTime @map("expires_at")
  scope        String   @map("scope") @db.Text
  provider     Provider @default(GOOGLE) @map("provider")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("oauth_tokens")
}

model EmailSummary {
  id             String   @id @default(uuid()) @map("id")
  userId         String   @map("user_id")
  gmailMessageId String   @unique @map("gmail_message_id")
  sender         String   @map("sender")
  /// The address parsed out of `sender`, stored separately because `sender` is
  /// a display string the sender chooses ("Ada <ada@example.com>") and grouping
  /// by it would split one person across every display name they have used.
  /// Null on rows written before this column existed; those rows simply never
  /// contribute to a sender's count.
  senderAddress  String?  @map("sender_address")
  subject        String   @map("subject")
  priority       Priority @map("priority")
  summaryText    String   @map("summary_text") @db.Text
  suggestedReply String?  @map("suggested_reply") @db.Text
  status         Status   @default(PENDING) @map("status")
  snoozedUntil   DateTime? @map("snoozed_until")
  /// When the user actually replied. `createdAt` is when the AI summarized the
  /// mail, which is not the same thing — a snoozed or re-digested email makes
  /// the gap arbitrary — so time-to-reply needs its own column.
  sentAt         DateTime? @map("sent_at")
  /// DismissedAt's counterpart to sentAt. Status is mutable and unlogged, so
  /// without this a weekly "how much did you handle" count can only be
  /// approximated by arrival date and misreports anything handled later than it
  /// arrived. Null on every row that has not been dismissed.
  dismissedAt    DateTime? @map("dismissed_at")
  /// The original message text, as plain text.
  ///
  /// Kept because the digest pipeline already fetches the full body to
  /// summarize it and then threw it away, so storing it is free — the network
  /// call was already paid for. Without it "view the original" can only be a
  /// second round trip to the provider, which is slow and impossible once the
  /// token is revoked. Null on rows written before this column existed; those
  /// backfill lazily on first view, and if that fetch fails they keep showing
  /// the AI summary alone.
  bodyText       String?   @db.LongText @map("body_text")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, sentAt])
  @@index([userId, dismissedAt])
  @@index([userId, senderAddress])
  @@map("email_summaries")
}

model SenderPreference {
  id                    String    @id @default(uuid()) @map("id")
  userId                String    @map("user_id")
  senderAddress         String    @map("sender_address")
  senderName            String?   @map("sender_name")
  /// How many of this sender's emails the user dismissed while they were
  /// classified LOW priority. That conjunction is deliberate — a LOW email the
  /// user actually read is not evidence they want less of this sender, and a
  /// MEDIUM one they dismissed might well be mail they wanted.
  lowDismissals         Int       @default(0) @map("low_dismissals")
  /// Set when the user dismisses the "consider unsubscribing" banner. Kept as a
  /// row rather than derived from a count because a derived query has nowhere to
  /// put it, and re-showing a banner the user already said no to is the failure
  /// mode that makes this kind of feature get uninstalled.
  suggestionDismissedAt DateTime? @map("suggestion_dismissed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, senderAddress])
  @@index([userId])
  @@map("sender_preferences")
}

model JobFailure {
  id           String   @id @default(uuid()) @map("id")
  userId       String   @map("user_id")
  jobType      String   @map("job_type")
  step         String   @map("step")
  errorMessage String   @map("error_message") @db.Text
  context      String?  @map("context") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("job_failures")
}

model Subscription {
  id               String   @id @default(uuid()) @map("id")
  userId           String   @unique @map("user_id")
  stripeCustomerId String   @unique @map("stripe_customer_id")
  plan             String   @map("plan")
  status           String   @map("status")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("subscriptions")
}

model MeetingReminder {
  id              String    @id @default(uuid()) @map("id")
  userId          String    @map("user_id")
  calendarEventId String    @map("calendar_event_id")
  title           String    @map("title")
  meetingTime     DateTime  @map("meeting_time")
  remindedAt      DateTime? @map("reminded_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, calendarEventId, meetingTime])
  @@index([userId])
  @@map("meeting_reminders")
}

model MeetingMinutes {
  id          String    @id @default(uuid()) @map("id")
  userId      String    @map("user_id")
  title       String    @map("title")
  rawNotes    String    @map("raw_notes") @db.Text
  attendees   String?   @map("attendees") @db.Text
  summaryText String    @map("summary_text") @db.Text
  decisions   String    @map("decisions") @db.Text
  actionItems String    @map("action_items") @db.Text
  nextSteps   String?   @map("next_steps") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("meeting_minutes")
}

model ScheduleBlock {
  id        String         @id @default(uuid()) @map("id")
  userId    String         @map("user_id")
  title     String         @map("title")
  startTime DateTime       @map("start_time")
  endTime   DateTime       @map("end_time")
  status    ScheduleStatus @default(PENDING) @map("status")
  date      DateTime       @map("date") @db.Date
  createdAt DateTime       @default(now()) @map("created_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([userId, date])
  @@map("schedule_blocks")
}

model ReplyFeedback {
  id             String   @id @default(uuid()) @map("id")
  emailId        String   @map("email_id")
  userId         String   @map("user_id")
  generatedReply String   @map("generated_reply") @db.Text
  finalReply     String   @map("final_reply") @db.Text
  /// True when the user sent the AI's suggestion without changing it.
  ///
  /// Recorded rather than dropped, and this is the difference between learning
  /// anything useful and learning the wrong thing. The only signal this table
  /// used to keep was "what the user changed", so a model trained on it
  /// converges on "be shorter, be blander" — it never sees that most replies
  /// were fine as written, because that case was filtered out before it could
  /// be counted. Accepted sends are the positive examples; rewrites say what to
  /// change, but only in proportion to how much of what was suggested the user
  /// actually kept.
  accepted       Boolean  @default(false)
  insertions     Int      @default(0) @map("insertions")
  deletions      Int      @default(0) @map("deletions")
  modifications  Int      @default(0) @map("modifications")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([emailId])
  /// The style analyser reads a user's most recent replies in one windowed
  /// query; without the composite MySQL falls back to scanning every row this
  /// user has ever sent and sorting in memory.
  @@index([userId, createdAt])
  @@map("reply_feedback")
}

/// The writing-style profile the background analyser maintains, one row per
/// user. Recomputed in full on every run rather than updated incrementally, so
/// there is no cursor column to drift out of sync: the job reads the most recent
/// N replies and writes the whole conclusion.
model ReplyStyleProfile {
  id         String   @id @default(uuid()) @map("id")
  userId     String   @unique @map("user_id")
  /// The model's description of how this user writes, fed back into the reply
  /// prompt. Text rather than structured fields because the useful signal is
  /// the model's own phrasing; constraining it to enums would throw away the
  /// part worth reading.
  styleNote  String   @db.LongText @map("style_note")
  /// How many replies the note was derived from, and how those split between
  /// accepted and rewritten. Shown to the user so a profile built from three
  /// samples does not read as a considered judgement.
  sampleCount    Int      @default(0) @map("sample_count")
  acceptedCount  Int      @default(0) @map("accepted_count")
  rewriteCount   Int      @default(0) @map("rewrite_count")
  analyzedAt     DateTime @default(now()) @map("analyzed_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reply_style_profiles")
}

enum Priority {
  HIGH
  MEDIUM
  LOW

  @@map("priority")
}

enum Status {
  PENDING
  SENT
  DISMISSED
  SNOOZED

  @@map("status")
}

enum ScheduleStatus {
  PENDING
  IN_PROGRESS
  DONE
  MISSED

  @@map("schedule_status")
}

enum Provider {
  GOOGLE
  MICROSOFT

  @@map("provider")
}